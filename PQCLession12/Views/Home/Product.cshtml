@model IEnumerable<PQCLession12.Models.PqcProduct>
@{
    ViewData["Title"] = "Lưới sản phẩm - Bài 2 Lab 06";
    var categories = ViewBag.Categories as IEnumerable<PQCLession12.Models.PqcCategory>;
    var currentCat = ViewBag.CurrentCategory as PQCLession12.Models.PqcCategory;
}

<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="text-primary mb-1">
                <i class="bi bi-grid-3x3-gap"></i> Danh sách Sản phẩm dạng lưới (Bài 2 Lab 06)
            </h2>
            <small class="text-muted">Sinh viên: <strong>Phùng Quang Cường</strong> | MSSV: <strong>2410900015</strong></small>
        </div>
        <a asp-controller="PqcProducts" asp-action="Index" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-table"></i> Quản lý CRUD
        </a>
    </div>

    <!-- Danh mục lọc dạng Pills/Tabs -->
    <div class="d-flex flex-wrap gap-2 mb-4">
        <a asp-action="Product" asp-route-categoryId="" class="btn btn-sm @(currentCat == null ? "btn-primary" : "btn-outline-primary")">
            Tất cả
        </a>
        @if (categories != null)
        {
            @foreach (var cat in categories)
            {
                <a asp-action="Product" asp-route-categoryId="@cat.Id" class="btn btn-sm @(currentCat?.Id == cat.Id ? "btn-primary" : "btn-outline-primary")">
                    @cat.PqcName
                </a>
            }
        }
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-secondary text-center py-4">
            Không có sản phẩm nào trong danh mục này.
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="bg-light text-center p-3 rounded-top position-relative" style="height: 200px;">
                            @if (!string.IsNullOrEmpty(item.PqcImage))
                            {
                                <img src="~/Product/@item.PqcImage" class="img-fluid h-100" style="object-fit: contain;" alt="@item.PqcName" onerror="this.onerror=null;this.src='https://placehold.co/200x200?text=PQC+Product';" />
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center h-100 text-muted">
                                    <i class="bi bi-image fs-1"></i>
                                </div>
                            }
                            <span class="position-absolute top-0 start-0 m-2 badge bg-primary">
                                @(item.PqcCategory?.PqcName ?? "Chung")
                            </span>
                        </div>
                        <div class="card-body d-flex flex-column p-3">
                            <h6 class="card-title fw-bold text-dark mb-1">@item.PqcName</h6>
                            <p class="text-muted small mb-2 text-truncate" style="max-height: 40px;">
                                @(item.PqcDescriptions ?? "Chưa có mô tả.")
                            </p>
                            <div class="mt-auto">
                                <div class="d-flex justify-content-between align-items-baseline">
                                    <span class="text-success fw-bold fs-5">@item.PqcPrice.ToString("#,##0") đ</span>
                                    @if (item.PqcSalePrice > 0 && item.PqcSalePrice < item.PqcPrice)
                                    {
                                        <small class="text-danger text-decoration-line-through">@item.PqcSalePrice.ToString("#,##0") đ</small>
                                    }
                                </div>
                                <div class="d-grid gap-1 mt-2">
                                    <a asp-controller="PqcProducts" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">
                                        Xem chi tiết
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
