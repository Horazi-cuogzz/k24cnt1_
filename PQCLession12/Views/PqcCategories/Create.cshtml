@model PQCLession12.Models.PqcCategory
@{
    ViewData["Title"] = "Thêm mới danh mục - PQC";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Thêm mới danh mục (PQC)</h5>
                    <small>Phùng Quang Cường - 2410900015</small>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="PqcName" class="form-label font-weight-bold"></label> <span class="text-danger">*</span>
                            <input asp-for="PqcName" class="form-control" placeholder="Nhập tên danh mục..." autofocus />
                            <span asp-validation-for="PqcName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PqcStatus" class="form-label"></label>
                            <select asp-for="PqcStatus" class="form-select">
                                <option value="1">Hiển thị</option>
                                <option value="0">Tạm khóa</option>
                            </select>
                            <span asp-validation-for="PqcStatus" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary">Quay lại danh sách</a>
                            <button type="submit" class="btn btn-success px-4">Lưu danh mục</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
