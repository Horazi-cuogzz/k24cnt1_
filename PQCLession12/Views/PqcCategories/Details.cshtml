@model PQCLession12.Models.PqcCategory
@{
    ViewData["Title"] = "Chi tiết danh mục - PQC";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Chi tiết danh mục (PQC)</h5>
                    <small>Phùng Quang Cường - 2410900015</small>
                </div>
                <div class="card-body p-4">
                    <dl class="row mb-4">
                        <dt class="col-sm-3 text-muted">@Html.DisplayNameFor(model => model.Id):</dt>
                        <dd class="col-sm-9"><span class="badge bg-secondary">#@Model.Id</span></dd>

                        <dt class="col-sm-3 text-muted">@Html.DisplayNameFor(model => model.PqcName):</dt>
                        <dd class="col-sm-9"><strong class="fs-5 text-dark">@Model.PqcName</strong></dd>

                        <dt class="col-sm-3 text-muted">@Html.DisplayNameFor(model => model.PqcStatus):</dt>
                        <dd class="col-sm-9">
                            @if (Model.PqcStatus == 1)
                            {
                                <span class="badge bg-success">Hiển thị</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Tạm khóa</span>
                            }
                        </dd>

                        <dt class="col-sm-3 text-muted">@Html.DisplayNameFor(model => model.PqcCreatedDate):</dt>
                        <dd class="col-sm-9">@Model.PqcCreatedDate.ToString("dd/MM/yyyy HH:mm")</dd>
                    </dl>

                    <h6 class="text-primary border-bottom pb-2">Danh sách sản phẩm trong danh mục (@(Model.PqcProducts?.Count ?? 0))</h6>
                    @if (Model.PqcProducts == null || !Model.PqcProducts.Any())
                    {
                        <p class="text-muted fst-italic">Chưa có sản phẩm nào thuộc danh mục này.</p>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush mb-4">
                            @foreach (var prod in Model.PqcProducts)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>@prod.PqcName</span>
                                    <span class="badge bg-primary">@prod.PqcPrice.ToString("#,##0") VNĐ</span>
                                </li>
                            }
                        </ul>
                    }

                    <div class="d-flex justify-content-between pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
                        <div>
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Chỉnh sửa</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
