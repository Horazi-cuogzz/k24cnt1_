@model IEnumerable<PQCLession12.Models.PqcCategory>
@{
    ViewData["Title"] = "Quản lý Danh mục - PQC";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="text-primary mb-1">
                <i class="bi bi-folder2-open"></i> Quản lý Danh mục (PQC)
            </h2>
            <small class="text-muted">Sinh viên: <strong>Phùng Quang Cường</strong> | MSSV: <strong>2410900015</strong> | Lớp: <strong>K24CNT1</strong></small>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-success">
                + Thêm mới danh mục
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Thanh tìm kiếm -->
    <div class="card mb-4 shadow-sm border-0">
        <div class="card-body py-2">
            <form asp-action="Index" method="get" class="row g-2 align-items-center">
                <div class="col-md-5">
                    <input type="text" name="search" class="form-control" placeholder="Tìm theo tên danh mục..." value="@ViewBag.CurrentSearch" />
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary">Tìm kiếm</button>
                    @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch as string))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary">Xóa lọc</a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Bảng danh sách -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 80px;">Mã</th>
                            <th>@Html.DisplayNameFor(model => model.PqcName)</th>
                            <th style="width: 140px;">Số sản phẩm</th>
                            <th style="width: 130px;">@Html.DisplayNameFor(model => model.PqcStatus)</th>
                            <th style="width: 170px;">@Html.DisplayNameFor(model => model.PqcCreatedDate)</th>
                            <th style="width: 200px;" class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">Chưa có danh mục nào. Hãy nhấn "Thêm mới danh mục" để bắt đầu!</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td><span class="badge bg-secondary">#@item.Id</span></td>
                                    <td><strong class="text-dark">@item.PqcName</strong></td>
                                    <td>
                                        <span class="badge bg-info text-dark">@(item.PqcProducts?.Count ?? 0) sản phẩm</span>
                                    </td>
                                    <td>
                                        @if (item.PqcStatus == 1)
                                        {
                                            <span class="badge bg-success">Hiển thị</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Tạm khóa</span>
                                        }
                                    </td>
                                    <td>@item.PqcCreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Sửa">Sửa</a>
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info" title="Chi tiết">Chi tiết</a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Xóa">Xóa</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
