@model PQCLession12.Models.PqcProduct
@{
    ViewData["Title"] = "Xác nhận xóa sản phẩm - PQC";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">Xác nhận xóa sản phẩm (PQC)</h5>
                    <small>Phùng Quang Cường - 2410900015</small>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-warning" role="alert">
                        <strong>Cảnh báo:</strong> Bạn có chắc chắn muốn xóa sản phẩm này không? Thao tác này không thể hoàn tác!
                    </div>

                    <div class="d-flex align-items-center mb-3 p-3 bg-light rounded">
                        @if (!string.IsNullOrEmpty(Model.PqcImage))
                        {
                            <img src="~/Product/@Model.PqcImage" alt="@Model.PqcName" class="img-thumbnail me-3" style="width: 80px; height: 80px; object-fit: cover;" onerror="this.onerror=null;this.src='https://placehold.co/80x80?text=No+Img';" />
                        }
                        <div>
                            <h5 class="mb-1 text-dark">@Model.PqcName</h5>
                            <span class="badge bg-primary">@(Model.PqcCategory?.PqcName ?? "Chưa phân loại")</span>
                            <div class="text-success fw-bold mt-1">@Model.PqcPrice.ToString("#,##0") VNĐ</div>
                        </div>
                    </div>

                    <dl class="row mb-4">
                        <dt class="col-sm-4 text-muted">Mã sản phẩm:</dt>
                        <dd class="col-sm-8"><span class="badge bg-secondary">#@Model.Id</span></dd>

                        <dt class="col-sm-4 text-muted">Trạng thái:</dt>
                        <dd class="col-sm-8">
                            @if (Model.PqcStatus == 1)
                            {
                                <span class="badge bg-success">Đang bán</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Tạm ngưng</span>
                            }
                        </dd>

                        <dt class="col-sm-4 text-muted">Ngày tạo:</dt>
                        <dd class="col-sm-8">@Model.PqcCreatedDate.ToString("dd/MM/yyyy HH:mm")</dd>
                    </dl>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-between pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary">Hủy bỏ</a>
                            <button type="submit" class="btn btn-danger px-4">Xác nhận xóa</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
