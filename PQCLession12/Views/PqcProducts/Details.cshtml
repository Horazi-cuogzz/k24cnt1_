@model PQCLession12.Models.PqcProduct
@{
    ViewData["Title"] = "Chi tiết sản phẩm - PQC";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-9">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Chi tiết sản phẩm (PQC)</h5>
                    <small>Phùng Quang Cường - 2410900015</small>
                </div>
                <div class="card-body p-4">
                    <div class="row">
                        <div class="col-md-5 text-center mb-3">
                            @if (!string.IsNullOrEmpty(Model.PqcImage))
                            {
                                <img src="~/Product/@Model.PqcImage" alt="@Model.PqcName" class="img-fluid rounded border shadow-sm" style="max-height: 280px; object-fit: contain;" onerror="this.onerror=null;this.src='https://placehold.co/300x300?text=No+Img';" />
                            }
                            else
                            {
                                <div class="bg-light border text-muted d-flex align-items-center justify-content-center rounded" style="height: 250px;">
                                    Chưa có hình ảnh
                                </div>
                            }
                        </div>
                        <div class="col-md-7">
                            <h3 class="text-primary mb-2">@Model.PqcName</h3>
                            <p class="text-muted">
                                Danh mục: <span class="badge bg-primary">@(Model.PqcCategory?.PqcName ?? "Chưa phân loại")</span>
                            </p>

                            <div class="p-3 bg-light rounded mb-3">
                                <div class="d-flex align-items-baseline mb-2">
                                    <span class="text-muted me-3">Đơn giá:</span>
                                    <h4 class="text-success mb-0 fw-bold">@Model.PqcPrice.ToString("#,##0") VNĐ</h4>
                                </div>
                                @if (Model.PqcSalePrice > 0 && Model.PqcSalePrice < Model.PqcPrice)
                                {
                                    <div class="d-flex align-items-baseline">
                                        <span class="text-muted me-3">Giá khuyến mãi:</span>
                                        <h5 class="text-danger mb-0 fw-bold">@Model.PqcSalePrice.ToString("#,##0") VNĐ</h5>
                                    </div>
                                }
                            </div>

                            <dl class="row mb-0">
                                <dt class="col-sm-4 text-muted">Trạng thái:</dt>
                                <dd class="col-sm-8">
                                    @if (Model.PqcStatus == 1)
                                    {
                                        <span class="badge bg-success">Đang bán</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Tạm ngưng</span>
                                    }
                                </dd>

                                <dt class="col-sm-4 text-muted">Ngày tạo:</dt>
                                <dd class="col-sm-8">@Model.PqcCreatedDate.ToString("dd/MM/yyyy HH:mm")</dd>
                            </dl>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.PqcDescriptions))
                    {
                        <div class="mt-4 pt-3 border-top">
                            <h6 class="text-muted">Mô tả sản phẩm:</h6>
                            <p class="text-dark" style="white-space: pre-line;">@Model.PqcDescriptions</p>
                        </div>
                    }

                    <div class="d-flex justify-content-between pt-4 mt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">Quay lại danh sách</a>
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Chỉnh sửa sản phẩm</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
