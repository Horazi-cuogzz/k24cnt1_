@model IEnumerable<PQCLession12.Models.PqcProduct>
@{
    ViewData["Title"] = "Quản lý Sản phẩm - PQC";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="text-primary mb-1">
                <i class="bi bi-box-seam"></i> Quản lý Sản phẩm (PQC)
            </h2>
            <small class="text-muted">Sinh viên: <strong>Phùng Quang Cường</strong> | MSSV: <strong>2410900015</strong> | Lớp: <strong>K24CNT1</strong></small>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-success">
                + Thêm mới sản phẩm
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Bộ lọc & Tìm kiếm -->
    <div class="card mb-4 shadow-sm border-0">
        <div class="card-body py-2">
            <form asp-action="Index" method="get" class="row g-2 align-items-center">
                <div class="col-md-4">
                    <input type="text" name="search" class="form-control" placeholder="Tìm tên hoặc mô tả sản phẩm..." value="@ViewBag.CurrentSearch" />
                </div>
                <div class="col-md-3">
                    <select name="categoryId" class="form-select" asp-items="ViewBag.CategoryId">
                        <option value="">-- Tất cả danh mục --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary">Lọc dữ liệu</button>
                    @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch as string) || ViewBag.CurrentCategoryId != null)
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary">Xóa bộ lọc</a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Bảng sản phẩm -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 70px;">Mã</th>
                            <th style="width: 100px;">Hình ảnh</th>
                            <th>@Html.DisplayNameFor(model => model.PqcName)</th>
                            <th style="width: 150px;">@Html.DisplayNameFor(model => model.PqcCategory)</th>
                            <th style="width: 130px;">@Html.DisplayNameFor(model => model.PqcPrice)</th>
                            <th style="width: 130px;">@Html.DisplayNameFor(model => model.PqcSalePrice)</th>
                            <th style="width: 110px;">Trạng thái</th>
                            <th style="width: 190px;" class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">Chưa có sản phẩm nào. Hãy nhấn "Thêm mới sản phẩm" để bắt đầu!</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td><span class="badge bg-secondary">#@item.Id</span></td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.PqcImage))
                                        {
                                            <img src="~/Product/@item.PqcImage" alt="@item.PqcName" class="img-thumbnail" style="width: 60px; height: 60px; object-fit: cover;" onerror="this.onerror=null;this.src='https://placehold.co/60x60?text=No+Img';" />
                                        }
                                        else
                                        {
                                            <div class="bg-light border text-muted d-flex align-items-center justify-content-center" style="width: 60px; height: 60px; font-size: 11px;">
                                                No Img
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <strong class="text-dark">@item.PqcName</strong>
                                        @if (!string.IsNullOrEmpty(item.PqcDescriptions))
                                        {
                                            <div class="small text-muted text-truncate" style="max-width: 250px;">
                                                @item.PqcDescriptions
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-primary">
                                            @(item.PqcCategory?.PqcName ?? "Chưa phân loại")
                                        </span>
                                    </td>
                                    <td><strong>@item.PqcPrice.ToString("#,##0") đ</strong></td>
                                    <td>
                                        @if (item.PqcSalePrice > 0 && item.PqcSalePrice < item.PqcPrice)
                                        {
                                            <span class="text-danger fw-bold">@item.PqcSalePrice.ToString("#,##0") đ</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.PqcStatus == 1)
                                        {
                                            <span class="badge bg-success">Đang bán</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Hết hàng</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Sửa">Sửa</a>
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info" title="Chi tiết">Chi tiết</a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Xóa">Xóa</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
