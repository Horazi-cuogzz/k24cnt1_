@model PQCLession13.Models.PqcProduct

@{
    ViewData["Title"] = "Thêm Sản Phẩm Mới";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="fw-bold mb-0 text-dark">Thêm Sản Phẩm Mới (Admin Area Form)</h4>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
            </a>
        </div>

        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div class="mb-3">
                        <label asp-for="PqcName" class="form-label fw-semibold">Tên sản phẩm</label>
                        <input asp-for="PqcName" class="form-control" placeholder="Nhập tên sản phẩm..." required />
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="PqcPrice" class="form-label fw-semibold">Giá bán (VNĐ)</label>
                            <input asp-for="PqcPrice" class="form-control" type="number" step="1000" placeholder="VD: 15000000" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PqcCategory" class="form-label fw-semibold">Danh mục</label>
                            <select asp-for="PqcCategory" class="form-select" required>
                                <option value="">-- Chọn danh mục --</option>
                                <option value="Laptop">Laptop</option>
                                <option value="Điện thoại">Điện thoại</option>
                                <option value="Phụ kiện">Phụ kiện</option>
                                <option value="Âm thanh">Âm thanh</option>
                                <option value="Màn hình">Màn hình</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PqcImageUrl" class="form-label fw-semibold">Đường dẫn hình ảnh (URL)</label>
                        <input asp-for="PqcImageUrl" class="form-control" placeholder="Để trống sẽ dùng ảnh mặc định..." />
                    </div>

                    <div class="mb-3">
                        <label asp-for="PqcDescription" class="form-label fw-semibold">Mô tả sản phẩm</label>
                        <textarea asp-for="PqcDescription" class="form-control" rows="3" placeholder="Nhập mô tả chi tiết..."></textarea>
                    </div>

                    <div class="form-check form-switch mb-4">
                        <input class="form-check-input" type="checkbox" asp-for="PqcStatus" checked />
                        <label class="form-check-label fw-semibold" asp-for="PqcStatus">Mở bán ngay (Trạng thái kích hoạt)</label>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-save me-1"></i> Lưu sản phẩm
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
