@model IEnumerable<PQCLession13.Models.PqcProduct>

@{
    ViewData["Title"] = "Quản Lý Sản Phẩm - Admin";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1 text-dark">Quản Lý Sản Phẩm (Area: Admin)</h3>
        <p class="text-muted mb-0 small">Bảng danh sách sản phẩm quản trị sử dụng Layout <code>_AdminLayout.cshtml</code></p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i> Thêm sản phẩm mới
        </a>
        <a asp-area="" asp-controller="Home" asp-action="CustomerDemo" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-eye me-1"></i> Xem giao diện Khách hàng
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm rounded-3">
    <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
        <span class="fw-bold text-dark">Tổng cộng: @Model.Count() sản phẩm</span>
        <div class="d-flex gap-2">
            <input type="text" class="form-control form-control-sm" placeholder="Tìm kiếm nhanh..." style="width: 220px;" />
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 60px;">ID</th>
                    <th style="width: 80px;">Hình ảnh</th>
                    <th>Tên sản phẩm</th>
                    <th>Danh mục</th>
                    <th>Giá bán</th>
                    <th>Mô tả tóm tắt</th>
                    <th>Trạng thái</th>
                    <th class="text-end" style="width: 130px;">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold text-muted">#@item.Id</td>
                        <td>
                            <img src="@item.PqcImageUrl" alt="@item.PqcName" class="rounded border" style="width: 50px; height: 50px; object-fit: cover;" />
                        </td>
                        <td class="fw-semibold">@item.PqcName</td>
                        <td><span class="badge bg-secondary-subtle text-secondary">@item.PqcCategory</span></td>
                        <td class="text-danger fw-bold">@String.Format("{0:N0} đ", item.PqcPrice)</td>
                        <td class="text-muted small text-truncate" style="max-width: 240px;">@item.PqcDescription</td>
                        <td>
                            @if (item.PqcStatus)
                            {
                                <span class="badge bg-success-subtle text-success">Đang mở bán</span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger">Tạm ngừng</span>
                            }
                        </td>
                        <td class="text-end">
                            <a href="javascript:void(0)" class="btn btn-sm btn-outline-primary" data-pqc-action="Sửa sản phẩm #@item.Id" title="Sửa">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" onclick="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này?');" title="Xóa">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
