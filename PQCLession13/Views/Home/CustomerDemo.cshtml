@model IEnumerable<PQCLession13.Models.PqcProduct>

@{
    // Slide 11-12: Chọn Layout tùy biến cho View
    Layout = "_LayoutHome";
    ViewData["Title"] = "Giao Diện Khách Hàng (Customer Layout Demo)";
}

<!-- Hero Banner riêng của Customer Layout -->
<div class="pqc-hero-banner text-center position-relative overflow-hidden mb-4">
    <span class="pqc-hero-badge">
        <i class="bi bi-tag-fill me-1"></i> ƯU ĐÃI ĐẶC BIỆT K24CNT1
    </span>
    <h2 class="display-6 fw-bold mb-2">PQC SHOPPING CENTER</h2>
    <p class="lead mb-3">Giao diện khách hàng sử dụng Layout tùy biến <code>_LayoutHome.cshtml</code> & CSS tùy biến theo Slide 16</p>
    <div class="d-flex justify-content-center gap-2">
        <a href="#productList" class="btn btn-light btn-sm fw-semibold text-primary px-3">
            <i class="bi bi-arrow-down-circle me-1"></i> Khám phá sản phẩm
        </a>
        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-light btn-sm fw-semibold px-3">
            <i class="bi bi-shield-lock me-1"></i> Chuyển sang Admin Area
        </a>
    </div>
</div>

<!-- Thanh bộ lọc nhanh -->
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4 bg-white p-3 rounded-3 shadow-sm" id="productList">
    <div>
        <h5 class="fw-bold mb-0 text-dark">
            <i class="bi bi-grid-3x3-gap-fill text-primary me-2"></i> Danh Sách Sản Phẩm Nổi Bật
        </h5>
        <small class="text-muted">Được render trong vùng <code>@@RenderBody()</code> của <code>_LayoutHome.cshtml</code></small>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-sm btn-outline-primary active" data-pqc-action="Lọc: Tất cả">Tất cả</button>
        <button class="btn btn-sm btn-outline-secondary" data-pqc-action="Lọc: Laptop">Laptop</button>
        <button class="btn btn-sm btn-outline-secondary" data-pqc-action="Lọc: Điện thoại">Điện thoại</button>
        <button class="btn btn-sm btn-outline-secondary" data-pqc-action="Lọc: Phụ kiện">Phụ kiện</button>
    </div>
</div>

<!-- Lưới sản phẩm (Product Grid) -->
<div class="row g-4">
    @foreach (var item in Model)
    {
        <div class="col-sm-6 col-lg-4">
            <div class="card pqc-product-card h-100">
                <div class="position-relative">
                    <img src="@item.PqcImageUrl" class="card-img-top" alt="@item.PqcName" />
                    <span class="position-absolute top-0 start-0 m-2 badge bg-primary">
                        @item.PqcCategory
                    </span>
                    @if (!item.PqcStatus)
                    {
                        <span class="position-absolute top-0 end-0 m-2 badge bg-danger">
                            Tạm hết hàng
                        </span>
                    }
                </div>
                <div class="card-body d-flex flex-column">
                    <h6 class="card-title fw-bold text-dark mb-1">@item.PqcName</h6>
                    <p class="card-text text-muted small flex-grow-1">@item.PqcDescription</p>
                    <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                        <span class="pqc-price-tag">@String.Format("{0:N0} đ", item.PqcPrice)</span>
                        <button class="btn btn-sm btn-primary rounded-pill px-3" data-pqc-action="Thêm giỏ hàng: @item.PqcName">
                            <i class="bi bi-cart-plus me-1"></i> Chọn mua
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
