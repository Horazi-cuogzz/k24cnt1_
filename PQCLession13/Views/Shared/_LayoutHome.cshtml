<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PQC Store (Customer Layout)</title>
    
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    
    <!-- Slide 16: Kéo thả / Liên kết tệp CSS tùy biến vào Layout -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pqc-custom.css" asp-append-version="true" />
    
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-light d-flex flex-column min-vh-100">
    <!-- Top info bar -->
    <div class="bg-dark text-white py-1 small">
        <div class="container d-flex justify-content-between align-items-center">
            <div>
                <i class="bi bi-person-badge me-1"></i> Sinh viên: <strong>Phùng Quang Cường (2410900015)</strong> - K24CNT1
            </div>
            <div>
                <span class="badge bg-warning text-dark me-2">Session 07 / Lesson 13: Layout & Custom Views</span>
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="btn btn-sm btn-outline-light py-0">
                    <i class="bi bi-shield-lock me-1"></i> Chuyển sang Area Admin
                </a>
            </div>
        </div>
    </div>

    <!-- Main Navigation Bar (Slide 20-21: Xử lý active nav links) -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg pqc-navbar-custom">
            <div class="container">
                <a class="navbar-brand fw-bold text-primary d-flex align-items-center gap-2" asp-controller="Home" asp-action="CustomerDemo">
                    <i class="bi bi-shop fs-3"></i>
                    <span>PQC Store <small class="fs-6 text-muted fw-normal">| Customer Portal</small></span>
                </a>
                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#pqcNav" aria-controls="pqcNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="collapse navbar-collapse" id="pqcNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link pqc-nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Giới thiệu Bài học
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link pqc-nav-link" asp-controller="Home" asp-action="CustomerDemo">
                                <i class="bi bi-grid-fill me-1"></i> Xem Layout Khách Hàng
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link pqc-nav-link" asp-controller="Home" asp-action="About">
                                <i class="bi bi-info-circle me-1"></i> Giới thiệu Layout
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link pqc-nav-link" asp-controller="Home" asp-action="Contact">
                                <i class="bi bi-envelope me-1"></i> Liên hệ
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        <div class="input-group">
                            <input type="text" class="form-control form-control-sm" placeholder="Tìm kiếm sản phẩm..." />
                            <button class="btn btn-sm btn-outline-primary" type="button"><i class="bi bi-search"></i></button>
                        </div>
                        <a href="javascript:void(0)" class="btn btn-outline-secondary btn-sm position-relative ms-2" data-pqc-action="Giỏ hàng">
                            <i class="bi bi-cart3 fs-5"></i>
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                3
                            </span>
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content Container -->
    <main role="main" class="flex-grow-1 py-4">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <!-- Footer for Customer Layout -->
    <footer class="bg-white border-top text-muted mt-auto py-4">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-4">
                    <h6 class="text-primary fw-bold"><i class="bi bi-award me-1"></i> PQC STORE DEMO</h6>
                    <p class="small mb-1">Dự án thực hành Lesson 13 (Session 07): Tìm hiểu về Layout trong ASP.NET Core MVC.</p>
                    <p class="small text-muted">&copy; 2026 - Phùng Quang Cường (2410900015). Bảo lưu mọi quyền.</p>
                </div>
                <div class="col-md-4">
                    <h6 class="fw-bold text-dark">Liên kết nhanh</h6>
                    <ul class="list-unstyled small mb-0">
                        <li><a asp-controller="Home" asp-action="CustomerDemo" class="text-decoration-none text-muted">Layout Khách hàng</a></li>
                        <li><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="text-decoration-none text-muted">Layout Quản trị (Admin Area)</a></li>
                        <li><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Về trang điều hướng chính</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6 class="fw-bold text-dark">Thông tin hỗ trợ</h6>
                    <p class="small mb-1"><i class="bi bi-geo-alt me-1"></i> Khoa CNTT - Lớp K24CNT1</p>
                    <p class="small mb-1"><i class="bi bi-telephone me-1"></i> Hotline hỗ trợ: 0987.xxx.xxx</p>
                    <p class="small mb-0"><i class="bi bi-envelope me-1"></i> Email: cuonghg333@gmail.com</p>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <!-- Slide 19-21: Custom JS -->
    <script src="~/js/pqc-custom.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
