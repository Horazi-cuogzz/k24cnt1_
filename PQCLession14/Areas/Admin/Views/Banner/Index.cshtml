@model IEnumerable<PQCLession14.Models.Banner>
@{
    ViewData["Title"] = "Quản lý Banner";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="m-0 text-dark font-weight-bold">Quản lý Banner</h3>
        <small class="text-muted">Danh sách các banner quảng cáo & slider trang chủ</small>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i> Thêm mới Banner
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3">
        <h5 class="card-title m-0 font-weight-bold text-primary">
            <i class="bi bi-card-image me-1"></i> Danh sách Banner (@(Model?.Count() ?? 0))
        </h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 60px;" class="text-center">#ID</th>
                        <th style="width: 140px;">Hình ảnh</th>
                        <th>Tên Banner</th>
                        <th class="text-center" style="width: 100px;">Thứ tự</th>
                        <th class="text-center" style="width: 120px;">Trạng thái</th>
                        <th style="width: 180px;" class="text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center font-weight-bold">@item.Id</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.Image))
                                    {
                                        <img src="@item.Image" alt="@item.Name" class="rounded border" style="width: 120px; height: 50px; object-fit: cover;" onerror="this.style.display='none';" />
                                    }
                                    else
                                    {
                                        <div class="bg-light border rounded d-flex align-items-center justify-content-center text-muted" style="width: 120px; height: 50px;">
                                            <i class="bi bi-image"></i>
                                        </div>
                                    }
                                </td>
                                <td>
                                    <span class="font-weight-bold text-dark">@item.Name</span>
                                    @if (!string.IsNullOrEmpty(item.Description))
                                    {
                                        <div class="small text-muted text-truncate" style="max-width: 350px;">@item.Description</div>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-secondary">Ưu tiên: @item.Prioty</span>
                                </td>
                                <td class="text-center">
                                    @if (item.Status == 1)
                                    {
                                        <span class="badge bg-success">Hiển thị</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Tạm ẩn</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info text-white" title="Chi tiết">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning text-white" title="Chỉnh sửa">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger" title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                Chưa có banner nào.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
