@model PQCLession14.Models.Blog
@{
    ViewData["Title"] = "Chi tiết bài viết";
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="card-title m-0 font-weight-bold text-info">
            <i class="bi bi-info-circle me-1"></i> Chi tiết bài viết: @Model.Name
        </h5>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm text-white">
                <i class="bi bi-pencil-square me-1"></i> Chỉnh sửa
            </a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger btn-sm">
                <i class="bi bi-trash me-1"></i> Xóa
            </a>
        </div>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-4 text-center mb-3">
                @if (!string.IsNullOrEmpty(Model.Image))
                {
                    <img src="@Model.Image" alt="@Model.Name" class="img-fluid rounded border shadow-sm" style="max-height: 250px;" onerror="this.style.display='none';" />
                }
                else
                {
                    <div class="bg-light border rounded d-flex align-items-center justify-content-center text-muted" style="height: 250px;">
                        <i class="bi bi-image fs-1"></i>
                    </div>
                }
            </div>
            <div class="col-md-8">
                <table class="table table-bordered">
                    <tbody>
                        <tr>
                            <th style="width: 200px;" class="bg-light">Mã bài viết (#ID)</th>
                            <td>@Model.Id</td>
                        </tr>
                        <tr>
                            <th class="bg-light">Tiêu đề bài viết</th>
                            <td class="font-weight-bold text-dark fs-5">@Model.Name</td>
                        </tr>
                        <tr>
                            <th class="bg-light">Trạng thái</th>
                            <td>
                                @if (Model.Status == 1)
                                {
                                    <span class="badge bg-success">Công khai (Hiển thị)</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Bản nháp (Tạm ẩn)</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th class="bg-light">Ngày đăng bài</th>
                            <td>@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm:ss")</td>
                        </tr>
                        <tr>
                            <th class="bg-light">Nội dung</th>
                            <td style="white-space: pre-line;">@(string.IsNullOrEmpty(Model.Description) ? "Không có nội dung" : Model.Description)</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
