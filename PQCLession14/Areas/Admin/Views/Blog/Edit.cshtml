@model PQCLession14.Models.Blog
@{
    ViewData["Title"] = "Chỉnh sửa bài viết";
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3">
        <h5 class="card-title m-0 font-weight-bold text-warning">
            <i class="bi bi-pencil-square me-1"></i> Chỉnh sửa bài viết: @Model.Name
        </h5>
    </div>
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <input type="hidden" asp-for="Id" />

            <div class="row">
                <div class="col-md-8 mb-3">
                    <label asp-for="Name" class="form-label font-weight-bold">Tiêu đề bài viết <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="Status" class="form-label font-weight-bold">Trạng thái xuất bản</label>
                    <select asp-for="Status" class="form-select">
                        <option value="1">Công khai (Hiển thị)</option>
                        <option value="0">Bản nháp (Tạm ẩn)</option>
                    </select>
                    <span asp-validation-for="Status" class="text-danger small"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Image" class="form-label font-weight-bold">Ảnh đại diện bài viết</label>
                    <input asp-for="Image" class="form-control" />
                    <span asp-validation-for="Image" class="text-danger small"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="CreatedDate" class="form-label font-weight-bold">Ngày đăng</label>
                    <input asp-for="CreatedDate" class="form-control" type="datetime-local" />
                    <span asp-validation-for="CreatedDate" class="text-danger small"></span>
                </div>

                <div class="col-12 mb-3">
                    <label asp-for="Description" class="form-label font-weight-bold">Nội dung tóm tắt / Chi tiết</label>
                    <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning text-white">
                    <i class="bi bi-save me-1"></i> Cập nhật thay đổi
                </button>
                <a asp-action="Index" class="btn btn-light">Hủy bỏ</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
