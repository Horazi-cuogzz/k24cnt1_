@model IEnumerable<PQCLession14.Models.Product>
@{
    ViewData["Title"] = "Bảng Điều Khiển (Dashboard)";
}

<div class="row g-3 mb-4">
    <div class="col-lg-3 col-6">
        <div class="card bg-primary text-white p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="fw-bold mb-0">@(ViewBag.CategoryCount ?? 0)</h2>
                    <p class="mb-0">Danh Mục Hàng</p>
                </div>
                <div class="fs-1 opacity-50">📁</div>
            </div>
            <a asp-area="Admin" asp-controller="Category" asp-action="Index" class="text-white text-decoration-none mt-3 d-inline-block small">
                Chi tiết danh mục &rarr;
            </a>
        </div>
    </div>

    <div class="col-lg-3 col-6">
        <div class="card bg-success text-white p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="fw-bold mb-0">@(ViewBag.ProductCount ?? 0)</h2>
                    <p class="mb-0">Tổng Sản Phẩm</p>
                </div>
                <div class="fs-1 opacity-50">📦</div>
            </div>
            <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="text-white text-decoration-none mt-3 d-inline-block small">
                Chi tiết sản phẩm &rarr;
            </a>
        </div>
    </div>

    <div class="col-lg-3 col-6">
        <div class="card bg-warning text-dark p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="fw-bold mb-0">@(ViewBag.BannerCount ?? 0)</h2>
                    <p class="mb-0">Banner Quảng Cáo</p>
                </div>
                <div class="fs-1 opacity-50">🖼️</div>
            </div>
            <a asp-area="Admin" asp-controller="Banner" asp-action="Index" class="text-dark text-decoration-none mt-3 d-inline-block small">
                Chi tiết banner &rarr;
            </a>
        </div>
    </div>

    <div class="col-lg-3 col-6">
        <div class="card bg-danger text-white p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="fw-bold mb-0">@(ViewBag.BlogCount ?? 0)</h2>
                    <p class="mb-0">Bài Viết / Blogs</p>
                </div>
                <div class="fs-1 opacity-50">📰</div>
            </div>
            <a asp-area="Admin" asp-controller="Blog" asp-action="Index" class="text-white text-decoration-none mt-3 d-inline-block small">
                Chi tiết bài viết &rarr;
            </a>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-bold">Danh sách sản phẩm mới cập nhật</span>
                <a asp-area="Admin" asp-controller="Product" asp-action="Create" class="btn btn-primary btn-sm">
                    + Thêm sản phẩm mới
                </a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Mã</th>
                                <th>Tên sản phẩm</th>
                                <th>Danh mục</th>
                                <th>Giá bán</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var p in Model)
                                {
                                    <tr>
                                        <td>#@p.Id</td>
                                        <td class="fw-semibold">@p.Name</td>
                                        <td><span class="badge bg-light text-dark border">@(p.Category?.Name ?? "N/A")</span></td>
                                        <td class="text-danger fw-bold">@p.Price.ToString("N0") VNĐ</td>
                                        <td>
                                            @if (p.Status == 1)
                                            {
                                                <span class="badge bg-success">Hiển thị</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Tạm ẩn</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-3 text-muted">Chưa có dữ liệu</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm mb-4">
            <div class="card-header fw-bold">
                Thao tác quản trị nhanh
            </div>
            <div class="card-body d-flex flex-column gap-2">
                <a asp-area="Admin" asp-controller="Category" asp-action="Create" class="btn btn-outline-primary text-start">
                    ➕ Thêm mới danh mục hàng
                </a>
                <a asp-area="Admin" asp-controller="Product" asp-action="Create" class="btn btn-outline-success text-start">
                    ➕ Thêm mới sản phẩm thiết bị
                </a>
                <a asp-area="Admin" asp-controller="Banner" asp-action="Create" class="btn btn-outline-warning text-start">
                    ➕ Thêm mới banner trình chiếu
                </a>
                <a asp-area="Admin" asp-controller="Blog" asp-action="Create" class="btn btn-outline-danger text-start">
                    ➕ Thêm mới bài viết tin tức
                </a>
            </div>
        </div>

        <div class="card shadow-sm border-primary">
            <div class="card-header bg-primary text-white fw-bold">
                Thông tin sinh viên thực hiện
            </div>
            <div class="card-body">
                <p class="mb-1"><strong>Họ và tên:</strong> Phùng Quang Cường</p>
                <p class="mb-1"><strong>Mã sinh viên:</strong> 2410900015</p>
                <p class="mb-1"><strong>Lớp:</strong> K24CNT1</p>
                <p class="mb-1"><strong>Học phần:</strong> ASP.NET Core MVC</p>
                <p class="mb-0"><strong>Bài học:</strong> PQCLession14 (Layout, Area & EF Core)</p>
            </div>
        </div>
    </div>
</div>
