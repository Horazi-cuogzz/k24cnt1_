@model PQCLession14.Models.Product
@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="card-title m-0 font-weight-bold text-info">
            <i class="bi bi-info-circle me-1"></i> Chi tiết sản phẩm: @Model.Name
        </h5>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm text-white">
                <i class="bi bi-pencil-square me-1"></i> Chỉnh sửa
            </a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger btn-sm">
                <i class="bi bi-trash me-1"></i> Xóa
            </a>
        </div>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-4 text-center mb-3">
                @if (!string.IsNullOrEmpty(Model.Image))
                {
                    <img src="@Model.Image" alt="@Model.Name" class="img-fluid rounded border shadow-sm" style="max-height: 280px;" onerror="this.style.display='none';" />
                }
                else
                {
                    <div class="bg-light border rounded d-flex align-items-center justify-content-center text-muted" style="height: 280px;">
                        <i class="bi bi-image fs-1"></i>
                    </div>
                }
            </div>
            <div class="col-md-8">
                <table class="table table-bordered">
                    <tbody>
                        <tr>
                            <th style="width: 200px;" class="bg-light">Mã sản phẩm (#ID)</th>
                            <td>@Model.Id</td>
                        </tr>
                        <tr>
                            <th class="bg-light">Tên sản phẩm</th>
                            <td class="font-weight-bold text-dark fs-5">@Model.Name</td>
                        </tr>
                        <tr>
                            <th class="bg-light">Danh mục</th>
                            <td>
                                <span class="badge bg-info text-dark">@(Model.Category?.Name ?? "Chưa phân loại")</span>
                            </td>
                        </tr>
                        <tr>
                            <th class="bg-light">Giá niêm yết</th>
                            <td class="text-primary font-weight-bold fs-5">@Model.Price.ToString("N0") VNĐ</td>
                        </tr>
                        <tr>
                            <th class="bg-light">Giá khuyến mãi</th>
                            <td>
                                @if (Model.SalePrice > 0)
                                {
                                    <span class="text-danger font-weight-bold fs-5">@Model.SalePrice.ToString("N0") VNĐ</span>
                                }
                                else
                                {
                                    <span class="text-muted">Không có khuyến mãi</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th class="bg-light">Trạng thái kinh doanh</th>
                            <td>
                                @if (Model.Status == 1)
                                {
                                    <span class="badge bg-success">Đang kinh doanh</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Ngừng kinh doanh</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th class="bg-light">Ngày khởi tạo</th>
                            <td>@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm:ss")</td>
                        </tr>
                        <tr>
                            <th class="bg-light">Mô tả sản phẩm</th>
                            <td>@(string.IsNullOrEmpty(Model.Description) ? "Không có mô tả chi tiết" : Model.Description)</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
