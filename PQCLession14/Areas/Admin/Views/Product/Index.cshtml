@model IEnumerable<PQCLession14.Models.Product>
@{
    ViewData["Title"] = "Quản lý sản phẩm";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="m-0 text-dark font-weight-bold">Quản lý sản phẩm</h3>
        <small class="text-muted">Danh sách tất cả sản phẩm của cửa hàng</small>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i> Thêm mới sản phẩm
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3">
        <h5 class="card-title m-0 font-weight-bold text-primary">
            <i class="bi bi-box-seam me-1"></i> Danh sách sản phẩm (@(Model?.Count() ?? 0))
        </h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 60px;" class="text-center">#ID</th>
                        <th>Hình ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Danh mục</th>
                        <th>Giá niêm yết</th>
                        <th>Giá khuyến mãi</th>
                        <th class="text-center">Trạng thái</th>
                        <th style="width: 180px;" class="text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center font-weight-bold">@item.Id</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.Image))
                                    {
                                        <img src="@item.Image" alt="@item.Name" class="rounded border" style="width: 50px; height: 50px; object-fit: cover;" onerror="this.style.display='none';" />
                                    }
                                    else
                                    {
                                        <div class="bg-light border rounded d-flex align-items-center justify-content-center text-muted" style="width: 50px; height: 50px;">
                                            <i class="bi bi-image"></i>
                                        </div>
                                    }
                                </td>
                                <td>
                                    <span class="font-weight-bold text-dark">@item.Name</span>
                                    <div class="small text-muted">Tạo ngày: @item.CreatedDate.ToString("dd/MM/yyyy")</div>
                                </td>
                                <td>
                                    <span class="badge bg-info text-dark">@(item.Category?.Name ?? "N/A")</span>
                                </td>
                                <td class="font-weight-bold text-primary">@item.Price.ToString("N0") đ</td>
                                <td>
                                    @if (item.SalePrice > 0)
                                    {
                                        <span class="badge bg-danger">@item.SalePrice.ToString("N0") đ</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Không áp dụng</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (item.Status == 1)
                                    {
                                        <span class="badge bg-success">Đang bán</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Ngừng bán</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info text-white" title="Chi tiết">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning text-white" title="Chỉnh sửa">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger" title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                Chưa có sản phẩm nào.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
