@model PQCLession7Models.Models.DataModels.PqcMember

@{
    ViewData["Title"] = "Create";
}

<div class="card p-3">
    <h1>Thêm mới thành viên</h1>
    <hr />
    <div class="row">
        <div class="col-md-4">
            <form asp-action="Create" method="post" asp-controller="PqcMember">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group">
                    <label asp-for="PqcMemberId" class="control-label"></label>
                    <input asp-for="PqcMemberId" class="form-control" />
                    <span asp-validation-for="PqcMemberId" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="PqcUserName" class="control-label"></label>
                    <input asp-for="PqcUserName" class="form-control" />
                    <span asp-validation-for="PqcUserName" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="PqcPassword" class="control-label"></label>
                    <input asp-for="PqcPassword" class="form-control" />
                    <span asp-validation-for="PqcPassword" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="PqcFullName" class="control-label"></label>
                    <input asp-for="PqcFullName" class="form-control" />
                    <span asp-validation-for="PqcFullName" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="PqcEmail" class="control-label"></label>
                    <input asp-for="PqcEmail" class="form-control" />
                    <span asp-validation-for="PqcEmail" class="text-danger"></span>
                </div>
                <div class="form-group my-2">
                    <input type="submit" value="Ghi lại" class="btn btn-primary" />
                    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
                </div>
            </form>
        </div>
    </div>
</div>
