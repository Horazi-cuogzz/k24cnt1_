@model IEnumerable<PQCLession7Models.Models.DataModels.PqcMember>

@{
    ViewData["Title"] = "Danh sách thành viên";
}

<div class="card p-3">
    <h1>@ViewData["Title"]</h1>

    <p>
        <a asp-action="Create" class="btn btn-primary my-1">Thêm mới</a>
    </p>
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.PqcMemberId)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.PqcUserName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.PqcPassword)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.PqcFullName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.PqcEmail)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model) {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.PqcMemberId)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PqcUserName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PqcPassword)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PqcFullName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PqcEmail)
                </td>
                <td>
                    @Html.ActionLink("Edit", "Edit", new { /* id=item.PrimaryKey */ }) |
                    @Html.ActionLink("Details", "Details", new { /* id=item.PrimaryKey */ }) |
                    @Html.ActionLink("Delete", "Delete", new { /* id=item.PrimaryKey */ })
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
