@model PQCLesson08Models.Models.PqcMember

@{
    ViewData["Title"] = "Xóa thành viên";
}

<div class="card p-3 border-danger">
    <div class="card-header bg-danger text-white">
        <h1>@ViewData["Title"]</h1>
    </div>
    <div class="card-body">
        <h3 class="text-danger">Bạn có chắc chắn muốn xóa thành viên này không?</h3>
        <hr />
        <dl class="row fs-5">
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.PqcMemberId)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.PqcMemberId)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.PqcUserName)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.PqcUserName)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.PqcPassword)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.PqcPassword)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.PqcFullName)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.PqcFullName)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.PqcEmail)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.PqcEmail)
            </dd>
        </dl>
    </div>
    
    <div class="card-footer">
        <form asp-action="PqcDeleted" method="post" class="d-inline">
            <input name="id" value="@Model?.PqcMemberId" type="hidden" />
            <input type="submit" value="Xóa" class="btn btn-danger me-2" />
        </form>
        <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
    </div>
</div>
