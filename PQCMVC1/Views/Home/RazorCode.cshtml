@{
    ViewData["Title"] = "Cau truc Razor";
}

<h1>@ViewData["Title"]</h1>
<hr/>
@{
    var diemToan = 85;
    var diemVan = 78;
    var tongDiem = diemToan + diemVan;
}

<p>Diem Toan: @diemToan</p>
<p>Diem Van: @diemVan</p>
<p>Tong diem: @tongDiem</p>

<h2>Cau truc if </h2>
<hr/>
    @if(tongDiem > 150)
    {
        <p>Xep loai Xuat sac</p>
    }
    else if (tongDiem > 130)
    {
        <p>Xep loai Gioi</p>
    }
    else if (tongDiem > 100)
    {
        <p>Xep loai Kha</p>
    }
    else
    {
        <p>Xep loai Trung binh</p>
    }

<h2>Cau truc for (....)</h2>

@for (int i = 1; i <= 5; i++)
{
    <span>@i - Buoi hoc ASP.NET Core</span>
}

<h2>Mang</h2>
@{
    string[] monHoc = { "Toan", "Van", "Ly", "Hoa", "Sinh" };
}
<ul>
@foreach (var item in monHoc)
{
    <li>@item</li>
}
</ul>