@model IEnumerable<PhungQuangCuong2410900015_exam.Models.PqcStudent>

@{
    ViewData["Title"] = "Danh sách sinh viên";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="text-primary fw-bold mb-0">DANH SÁCH SINH VIÊN (PqcStudent)</h2>
            <small class="text-muted">Quản lý danh sách sinh viên - Phùng Quang Cường (2410900015)</small>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle"></i> + Thêm mới sinh viên
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-primary text-nowrap">
                        <tr>
                            <th class="ps-3">Mã SV (Id)</th>
                            <th>Họ và tên (PqcName)</th>
                            <th>Giới tính (PqcGender)</th>
                            <th>Ngày sinh (PqcBirthDay)</th>
                            <th>Email (PqcEmail)</th>
                            <th>Điện thoại (PqcPhone)</th>
                            <th>Trạng thái (PqcActive)</th>
                            <th class="text-center pe-3">Chức năng</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model) {
                            <tr>
                                <td class="ps-3 fw-bold text-secondary">#@item.Id</td>
                                <td class="fw-semibold">@Html.DisplayFor(modelItem => item.PqcName)</td>
                                <td>
                                    @if (item.PqcGender == true)
                                    {
                                        <span class="badge bg-primary text-white">Nam</span>
                                    }
                                    else if (item.PqcGender == false)
                                    {
                                        <span class="badge bg-danger text-white">Nữ</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Chưa xác định</span>
                                    }
                                </td>
                                <td>
                                    @(item.PqcBirthDay?.ToString("dd/MM/yyyy") ?? "N/A")
                                </td>
                                <td>@Html.DisplayFor(modelItem => item.PqcEmail)</td>
                                <td>@Html.DisplayFor(modelItem => item.PqcPhone)</td>
                                <td>
                                    @if (item.PqcActive == true)
                                    {
                                        <span class="badge bg-success">Đang học</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Tạm dừng</span>
                                    }
                                </td>
                                <td class="text-center pe-3 text-nowrap">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning me-1">Sửa</a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info me-1">Chi tiết</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Xóa</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                Hiện chưa có dữ liệu sinh viên nào. Bấm <strong>Thêm mới</strong> để tạo sinh viên.
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
