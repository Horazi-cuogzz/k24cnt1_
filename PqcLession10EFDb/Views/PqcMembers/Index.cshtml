@model IEnumerable<PqcLession10EFDb.Models.PqcMember>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.PqcUserName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PqcPassword)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PqcFullName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PqcEmail)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PqcPhone)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PqcStatus)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.PqcUserName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PqcPassword)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PqcFullName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PqcEmail)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PqcPhone)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PqcStatus)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
